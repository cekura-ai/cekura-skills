{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cekura.ai/schemas/selfimprove-manifest.schema.json",
  "title": "Cekura self-improve capability manifest (.cekura/selfimprove.yaml)",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "agent", "environments", "authority", "source_of_truth", "simulate"],
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["run"],
      "properties": {
        "run": {
          "type": "string",
          "description": "Registered command template. Placeholders ({agent_ref}, {session_id}, {env}, {build_sha}) are typed and shell-escaped by the runner; no other interpolation is permitted."
        },
        "cwd": { "type": "string", "description": "Working directory relative to repo root. Default: repo root." },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600, "default": 120 },
        "env_allowlist": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Env var NAMES the command may receive. Values are never written to the manifest, logs, or memory."
        },
        "network": { "enum": ["none", "local", "staging", "provider"], "default": "local" },
        "writes": { "type": "boolean", "default": false, "description": "Whether the command mutates state. Read commands must declare false." }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "kind": { "enum": ["repo", "db", "langfuse", "provider", "other"] },
        "paths": {
          "type": "array",
          "items": { "type": "string" },
          "description": "repo kind only: files/globs that hold this component's source."
        },
        "read": { "$ref": "#/$defs/command", "description": "Dump this component's current source-of-truth value." },
        "apply": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["file_patch", "command", "provider_api", "manual"] },
            "command": { "$ref": "#/$defs/command" },
            "transactional": { "type": "boolean", "default": false },
            "idempotent": { "type": "boolean", "default": false }
          }
        },
        "rollback": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "how": { "enum": ["git", "command", "versioned", "manual", "none"] },
            "command": { "$ref": "#/$defs/command" },
            "notes": { "type": "string" }
          },
          "description": "Per-component rollback. 'git' is only valid for kind=repo. 'none' blocks Promote for edits touching this component unless the user explicitly accepts."
        }
      }
    }
  },
  "properties": {
    "version": { "type": "integer", "const": 1 },
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cekura_agent_id"],
      "properties": {
        "cekura_agent_id": { "type": "integer" },
        "source_ref": { "type": "string", "description": "How the agent is identified in the customer's stack (name, slug, config key)." },
        "runtime_refs": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Per-environment runtime identity (e.g. staging: VAPI assistant id). Used for trace correlation."
        }
      }
    },
    "environments": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["production"],
        "properties": {
          "kind": { "enum": ["local", "deployed"] },
          "production": { "type": "boolean" },
          "promote_requires": { "enum": ["manual"], "description": "production: true environments must set this." }
        }
      }
    },
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "allowed_paths": { "type": "array", "items": { "type": "string" } },
        "forbidden_paths": { "type": "array", "items": { "type": "string" } },
        "secrets_policy": { "enum": ["redact"], "default": "redact" },
        "approvers": { "type": "array", "items": { "type": "string" }, "description": "Who may confirm promotion / manifest changes." }
      }
    },
    "source_of_truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["components"],
      "properties": {
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/component" } }
      }
    },
    "render_intended": {
      "$ref": "#/$defs/command",
      "description": "Render the full intended runtime config from the sources (pre-deploy). Output is hashed as the intent baseline."
    },
    "read_live": {
      "$ref": "#/$defs/command",
      "description": "Dump the config the runtime is actually serving in {env}. Required for attestation whenever a deploy step exists."
    },
    "validate": { "$ref": "#/$defs/command", "description": "Dry-run / schema / rendering validation before deploy." },
    "deploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target_env"],
      "properties": {
        "target_env": { "type": "string" },
        "command": { "$ref": "#/$defs/command", "description": "Omit for live-on-save (noop)." },
        "sandbox_command": { "$ref": "#/$defs/command", "description": "Optional ephemeral/per-session deploy (clone equivalent)." },
        "produces": { "type": "array", "items": { "type": "string" }, "description": "Identity outputs to capture: runtime_agent_id, build_sha, prompt_version…" }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "traces": { "$ref": "#/$defs/command", "description": "Fetch traces (e.g. Langfuse) for a call/session id." },
        "logs": { "$ref": "#/$defs/command" }
      }
    },
    "simulate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner"],
      "properties": {
        "runner": { "type": "string", "description": "Cekura simulation runner tool name (e.g. scenarios_run_vapi_webrtc)." },
        "reset_fixtures": { "type": "array", "items": { "$ref": "#/$defs/command" }, "description": "Reset/seed customer mock servers or test data before a batch." },
        "flake_policy": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_infra_failures": { "type": "integer", "minimum": 0, "default": 1 },
            "retry_on": { "type": "array", "items": { "type": "string" }, "description": "Error classes retried without counting: timeout, transport_error, mock_unavailable…" }
          }
        }
      }
    },
    "promote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["how"],
      "properties": {
        "how": { "enum": ["pr", "pipeline", "provider_publish", "manual"] },
        "command": { "$ref": "#/$defs/command" },
        "rollback_verify": { "$ref": "#/$defs/command", "description": "Post-rollback readback to confirm the old version is live again." }
      }
    }
  }
}
