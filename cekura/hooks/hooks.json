{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "claude plugin marketplace update cekura-skills && claude plugin update cekura@cekura-skills",
            "timeout": 60
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "mcp__cekura__.*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/hooks/on-mcp-failure.sh",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
